<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var \Omeka\Entity\User|null $user
 * @var \Contribute\Form\ContributeForm $form
 * @var \AdvancedResourceTemplate\Api\Representation\ResourceTemplateRepresentation|null $resourceTemplate
 * @var \Contribute\Api\Representation\ContributionRepresentation|null $contribution
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation|null $resource
 * @var array $fields
 * @var \Omeka\Api\Representation\ResourceTemplateRepresentation|null $templateMedia A sub template for media may have no fields.
 * @var array $fieldsByMedia
 * @var array $fieldsMediaBase
 * @var string $action "add" or "edit" or "show"
 * @var string $mode "read" (for template select or for show readonly form before submit) or "write"
 * @var string $space "default" or "guest"
 *
 * @var string $submitLabel
 * @var string $cancelLabel
 * @var bool $isMainForm
 * @var bool $skipContributeCss
 *
 * When called recursively for sub-fields (media):
 * @var int|null $indexMedia
 * @var array $fieldsMedia
 *
 * @var \Laminas\View\HelperPluginManager $plugins
 * @var \Laminas\View\Helper\Url $url
 * @var \Laminas\View\Helper\Partial $partial
 * @var \Laminas\View\Helper\EscapeHtml $escape
 * @var \Laminas\I18n\View\Helper\Translate $translate
 * @var \Laminas\View\Helper\EscapeHtmlAttr $escapeAttr
 * @var \Omeka\Api\Manager $apiManager
 * @var \Common\Stdlib\EasyMeta $easyMeta
 * @var array $valueResourceTypes
 * @var array $valueResourceQueries
 * @var callable $shortResourceTitle
 * @var string $baseUrlFiles
 * @var string $mode
 *
 * @var array $steps
 * @var string $stepPart "top" ou "bottom"
 */

// Attention : étape "template" est un simple formulaire désactivé s'il y a une contribution.
// Sinon, c'est un bouton submit.

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');
$escapeAttr = $plugins->get('escapeHtmlAttr');

// Action, étape et mode en cours.
$currentActionStep = $steps['currentActionStep'];
$action = $steps['action'];
$step = $steps['step'];
$mode = $steps['mode'];
$isFirstPass = $steps['isFirstPass'] ?? true;
$visitedBeforeDepot = !empty($steps['visitedBeforeDepot']);

$hasContribution = $contribution && $contribution->id();
$addTemplateUrl = $escapeAttr($url('site/contribution', ['resource'=> 'contribution', 'action' => 'add'], true));
$editTemplateFreeUrl = $hasContribution
    ? $escapeAttr($contribution->url('edit') . '?step=template')
    : $addTemplateUrl;
$urls = [
    'add-template' => $addTemplateUrl,
    'edit-template' => $hasContribution ? $addTemplateUrl : '#',
    'add-notice' => $hasContribution ? $escapeAttr($contribution->url('edit')) : $escapeAttr($url('site/contribution', ['resource'=> 'contribution', 'action' => 'add'], true)),
    'edit-notice' => $hasContribution ? $escapeAttr($contribution->url('edit')) : $escapeAttr($url('site/contribution', ['resource'=> 'contribution', 'action' => 'add'], true)),
    'edit-fichiers' => $hasContribution ? $escapeAttr($contribution->url('edit') . '?next=fichiers') : $escapeAttr($url('site/contribution', ['resource'=> 'contribution', 'action' => 'add'], true) . '?step=fichiers'),
    'show-depot' => $hasContribution ? $escapeAttr($contribution->url('view')) : '#',
];

// Affichage en haut (avec les étapes) ou en bas (précédent/suivant).
$stepPart = $stepPart ?? 'top';

$formId = isset($form) ? $form->getAttribute('id') : null;
$action = $action ?? 'show';

$classes = $mode === 'read' && $action !== 'show' ? 'class="mode-read"' : 'class="mode-edit"';

// Labels des étapes (centralisés dans currentProcess()).
$stepLabels = $steps['stepLabels'];

// Valeurs de formulaire pour la barre d'étapes (write).
$stepBarValues = [
    'template' => 'add-template',
    'notice' => $action . '-notice',
    'fichiers' => $action . '-fichiers',
    'depot' => 'show-depot',
];

// URLs en mode lecture.
$stepReadUrls = [
    'template' => $isFirstPass ? $urls['add-template'] : $editTemplateFreeUrl,
    'notice' => $urls['edit-notice'] . '?mode=read',
    'fichiers' => $urls['edit-fichiers'] . '&mode=read',
    'depot' => $urls['show-depot'],
];

// URLs en navigation libre (write, après premier passage).
// Barre d'étapes : notice et fichiers sont sur la même page
// (edit.phtml) donc "#" pour éviter le rechargement.
$samePageSteps = ['notice', 'fichiers'];
$stepFreeBarUrls = [
    'template' => $editTemplateFreeUrl,
    'notice' => in_array($step, $samePageSteps) ? '#' : $urls['edit-notice'],
    'fichiers' => in_array($step, $samePageSteps) ? '#' : $urls['edit-fichiers'],
    'depot' => $urls['show-depot'],
];
// Prev/next : toujours des vraies URLs (rechargement).
$stepFreeNavUrls = [
    'template' => $editTemplateFreeUrl,
    'notice' => $urls['edit-notice'],
    'fichiers' => $urls['edit-fichiers'],
    'depot' => $urls['show-depot'],
];

// Navigation prev/next.
$prevStep = $steps['prevStep'];
$nextStep = $steps['nextStep'];

// Valeurs pour navigation avant (write, premier passage).
$nextStepValues = [
    'notice' => $action . '-notice',
    'fichiers' => 'edit-fichiers',
    'depot' => 'show-depot',
];
$nextActionStep = $nextStep
    ? ($nextStepValues[$nextStep] ?? null) : null;

// Index de l'étape courante : les étapes précédentes sont
// toujours navigables librement (liens, pas de submit).
$activeStepsOrder = array_flip($steps['activeSteps']);
$currentStepIndex = $activeStepsOrder[$step] ?? 0;

$prevReadUrl = $prevStep ? ($stepReadUrls[$prevStep] ?? null) : null;
$nextReadUrl = $nextStep ? ($stepReadUrls[$nextStep] ?? null) : null;
?>

<?php if ($mode === 'write'): ?>

<?php if ($stepPart === 'top'): ?>
<?= $this->pageTitle($translate('Nouveau dépôt'), 1) ?>
<ul class="navigation etapes-depot">
    <?php foreach ($steps['activeSteps'] as $activeStep):
        $isActive = $step === $activeStep;
        $label = $stepLabels[$activeStep];
    ?>
    <li class="<?= $isActive ? 'active' : 'inactive' ?>">
        <?php if (!$isFirstPass || ($activeStepsOrder[$activeStep] ?? 99) < $currentStepIndex || ($visitedBeforeDepot && $activeStep !== 'depot')): ?>
        <a href="<?= $isActive ? '#' : $stepFreeBarUrls[$activeStep] ?>"><span><?= $escape($label) ?></span></a>
        <?php elseif ($isActive || ($activeStep === 'depot' && $step === 'template')): ?>
        <button type="button" <?= $classes ?>><span><?= $escape($label) ?></span></button>
        <?php else: ?>
        <button type="submit" name="next" value="<?= $stepBarValues[$activeStep] ?>" form="<?= $formId ?>" <?= $classes ?>><span><?= $escape($label) ?></span></button>
        <?php endif; ?>
    </li>
    <?php endforeach; ?>
</ul>
<?php endif; ?>

<?php
$hasPrev = (bool) $prevStep;
$hasNext = ($isFirstPass && !$visitedBeforeDepot) ? (bool) $nextActionStep : (bool) $nextStep;
if ($hasPrev || $hasNext):
    $navClass = $hasPrev && $hasNext
        ? 'precedent-suivant'
        : ($hasPrev ? 'precedent' : 'suivant');
?>
<ul class="navigation <?= $navClass ?> navigation-<?= $stepPart ?>">
    <?php if ($hasPrev): ?>
    <li><a href="<?= $stepFreeNavUrls[$prevStep] ?>">Étape précédente</a></li>
    <?php endif; ?>
    <?php if ($hasNext): ?>
        <?php if ($isFirstPass && !$visitedBeforeDepot): ?>
    <li><button type="submit" <?= $classes ?> name="next" value="<?= $nextActionStep ?>" form="<?= $formId ?>">Étape suivante</button></li>
        <?php else: ?>
    <li><a href="<?= $stepFreeNavUrls[$nextStep] ?>">Étape suivante</a></li>
        <?php endif; ?>
    <?php endif; ?>
</ul>
<?php endif; ?>

<?php else: // Mode lecture. ?>

<?php if ($stepPart === 'top'): ?>
<?= $this->pageTitle($translate('Nouveau dépôt'), 1) ?>
<ul class="navigation etapes-depot">
    <?php foreach ($steps['activeSteps'] as $activeStep):
        $isActive = $step === $activeStep;
    ?>
    <li class="<?= $isActive ? 'active' : 'inactive' ?>">
        <a href="<?= $isActive ? '#' : $stepReadUrls[$activeStep] ?>"><span><?= $escape($stepLabels[$activeStep]) ?></span></a>
    </li>
    <?php endforeach; ?>
</ul>
<?php endif; ?>

<?php if ($prevReadUrl || $nextReadUrl):
    $navClass = $prevReadUrl && $nextReadUrl
        ? 'precedent-suivant'
        : ($prevReadUrl ? 'precedent' : 'suivant');
?>
<ul class="navigation <?= $navClass ?> navigation-<?= $stepPart ?>">
    <?php if ($prevReadUrl): ?>
    <li><a href="<?= $prevReadUrl ?>">Étape précédente</a></li>
    <?php endif; ?>
    <?php if ($nextReadUrl): ?>
    <li><a href="<?= $nextReadUrl ?>">Étape suivante</a></li>
    <?php endif; ?>
</ul>
<?php endif; ?>

<?php endif; ?>
