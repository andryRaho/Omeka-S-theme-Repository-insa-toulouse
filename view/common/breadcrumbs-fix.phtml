<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 * @var string $ariane
 */

// TODO Modifier les styles? Ou ajouter un vrai gabarit pour le fil d'Ariane.

// Supprimer ce qu'il y a après le dernier > pour ajouter un span afin de gérer
// l'élément en cours qui n'a pas de span et que les styles affichent mal.
// De plus, ce fil d'Ariane utilise ul/li.

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$last = mb_strripos($ariane, '</a>');
?>

<nav class="breadcrumbs content-with-margin" aria-label="<?= $translate('Breadcrumb') ?>">
    <ul>
        <?php if (!stripos($ariane, 'accueil')): ?>
        <li><a href="<?= $escapeAttr($url('site', ['site-slug' => $site->slug()])) ?>"><?= $escape($translate('Accueil')) ?></a></li>
        <?php endif; ?>
        <?= $last
            ? str_replace(['<a ', '</a>'], ['<li><a ', "</a></li>\n"], mb_substr($ariane, 0, $last + 4))
                . '<li><span>' . mb_substr($ariane, $last + 4) . "</span><li>\n"
            : '<li><span>' . $ariane . "</span></li>\n" ?>
    </ul>
</nav>
