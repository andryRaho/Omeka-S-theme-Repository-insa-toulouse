    : '';

$baseAssetUrl = $assetUrl('', null, false, false);
$baseSiteUrl = $site->url('site', [], true);

$mainColor = strtoupper($themeSetting('main_color', '')) ?: '#EA3535';
$accentColor = strtoupper($themeSetting('theme_color', '')) ?: '#BA0000';
?>
<?= $this->doctype() ?>
<?= $this->htmlElement('html') ?>
    <head>
        <?= $this->headMeta() ?>
        <?= $this->headTitle() ?>
        <meta name="theme-color" content="#000"/>
