                        <p><?= $escape($translate('L’accès au document est réservé aux utilisateurs authentifiés. Connectez-vous pour consulter ce document.')) ?></p>
                        <p><?= $escape($translate('Demander à l’administrateur du site pour plus d’information.')) ?></p>
                        <?php endif; ?>
                        <?php // Sans contact us. ?>
                        <?php elseif ($user && ($html = $themeSetting('access_warning_user'))): ?>
                        <?= $html ?>
                        <?php elseif (!$user && ($html = $themeSetting('access_warning_anonymous'))): ?>
                        <?= $html ?>
                        <?php elseif ($user): ?>
                        <p><?= $escape($translate('Demander à l’administrateur du site pour plus d’information.')) ?></p>
                        <?php else: ?>
                        <p><?= $escape($translate('L’accès au document est réservé aux utilisateurs authentifiés. Connectez-vous pour consulter ce document.')) ?></p>
                        <p><?= $escape($translate('Demander à l’administrateur du site pour plus d’information.')) ?></p>
                        <?php endif; ?>
                    </div>
                </div>
            </div>
