                <div class="limited-access-popup-content">
                    <div class="limited-access-close close-popup-btn">
                        <a href="#"></a>
                    </div>
                    <div class="limited-access-form-parent">
                        <h1><?= $translate('Ce document est en accès restreint')?></h1>
                        <?php if ($contactUs): ?>
                        <?php $html = $contactUs(['resource' => $resource, 'contact' => 'author', 'template' => 'common/contact-us-author']) ?>
                        <?php if (trim($html)): ?>
                        <p><?= $translate('Contacter l’auteur pour pouvoir consulter le document') ?></p>
                        <?= $html ?>
                        <?php elseif ($user && ($html = $themeSetting('access_warning_user'))): ?>
                        <?= $html ?>
                        <?php elseif (!$user && ($html = $themeSetting('access_warning_anonymous'))): ?>
                        <?= $html ?>
                        <?php elseif ($user): ?>
                        <?php /*
                        <p><?= $escape($translate('L’auteur ne peut pas être contacté directement.')) ?></p>
                        */?>
                        <p><?= $escape($translate('Demander à l’administrateur du site pour plus d’information.')) ?></p>
