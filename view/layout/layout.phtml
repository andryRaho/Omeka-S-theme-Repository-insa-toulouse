$searchConfig = $plugins->has('getSearchConfig') ? $plugins->get('getSearchConfig')() : null;

$siteTitle = $site->title();

$simpleRoute = $themeFunctions->simpleRoute();
$isResource = in_array($simpleRoute['controller'], ['item', 'item-set', 'media']);
$hasGuest = $plugins->has('guestWidget');
$navMenu = $plugins->has('navMenu') ? $plugins->get('navMenu') : null;
$contactUs = $plugins->has('contactUs') ? $plugins->get('contactUs') : null;
// $isSitePage = $simpleRoute['controller'] === 'page' && $simpleRoute['action'] === 'show';
// $isHomePage = $themeFunctions->isHomePage();

$this->htmlElement('html')
    ->setAttribute('lang', $this->lang());
$this->htmlElement('body')
    ->appendAttribute('class', 'body-inner');
$headMeta = $this->headMeta()
    ->setCharset('utf-8')
    ->appendName('viewport', 'width=device-width, initial-scale=1');

$metaCopyright = $themeSetting('meta_copyright', '');
if ($metaCopyright) {
    $headMeta->appendName('copyright', $metaCopyright);
}

$metaOwner = $themeSetting('meta_owner', '');
if ($metaOwner) {
    $headMeta->appendName('owner', $metaOwner);
}

$metaKeywords = $themeSetting('meta_keywords', '');
if ($metaKeywords) {
    $headMeta->appendName('keywords', $metaKeywords);
}

$this->headTitle($siteTitle)
    ->setSeparator(' · ')
    ->append($setting('installation_title', 'Omeka S'));

$headLink = $this->headLink()
