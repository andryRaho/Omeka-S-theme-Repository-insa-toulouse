                    <a href="<?= $escapeAttr(substr($link, 0, 1) === '/' ? $link : "$baseSiteUrl/page/$link") ?>" class="contact-link"><span><?= $translate('Contact') ?></span></a>
                    <?php endif; ?>
                    <?php if ($link = $themeSetting('header_page_support', 'aide')): ?>
                    <a href="<?= $escapeAttr(substr($link, 0, 1) === '/' ? $link : "$baseSiteUrl/page/$link") ?>" class="support-link"><span><?= $translate('Aide') ?></span></a>
                    <?php endif; ?>
                    <?php if ($user): ?>
                    <a href="<?= $hasGuest ? $baseSiteUrl . '/guest' : '/admin/user/' . $user->getId() ?>" class="login-link"><span><?= $translate('Mon compte') ?></span></a>
                    <?php else: ?>
                    <a href="<?= $hasGuest ? $baseSiteUrl . '/guest/login' : '/login' ?>" class="login-link"><span><?= $translate('S’identifier') ?></span></a>
                    <?php endif; ?>
