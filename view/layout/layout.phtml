        <div class="message content-with-margin">
            <p class="explanation <?= $status ?>"><?= $message ?></p>
        </div>
        <?php endif; ?>
        <main id="content" role="main" class="content-with-margin<?= empty($mainClass) ? '' : ' ' . $mainClass ?>">
            <?= $this->content ?>
