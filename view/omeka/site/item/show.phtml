<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation $item
 * @var \Omeka\Api\Representation\ItemRepresentation $resource
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 */

// Attention : les médias ne fonctionnent qu'avec les fichiers et il n'y a pas de visionneuse.

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');
$siteSetting = $plugins->get('siteSetting');
$escapeAttr = $plugins->get('escapeHtmlAttr');
$accessStatus = $plugins->has('accessStatus') ? $plugins->get('accessStatus') : null;
$themeSetting = $plugins->get('themeSetting');
$themeFunctions = $plugins->get('ThemeFunctions');
$isAllowedMediaContent = $plugins->has('isAllowedMediaContent') ? $plugins->get('isAllowedMediaContent') : null;

$this->htmlElement('body')->appendAttribute('class', 'item resource show');

$medias = $item->media();

$filterLocale = (bool) $siteSetting('filter_locale_values');
$siteLang = $plugins->get('lang')();
$lang = $filterLocale ? $siteLang : null;
$siteSlug = $site->slug();

$searchingUrl = $plugins->has('searchingUrl') ? $plugins->get('searchingUrl')() : $url('site/resource', ['site-slug' => $siteSlug]);

$documentType = $resource->displayResourceTemplateLabel();

$accessLevel = $themeFunctions->accessLevel($resource);
$accessLabel = $themeFunctions->accessLabel($accessLevel);
$citation = $themeFunctions->citation($resource);

$resourceTitle = $resource->displayTitle(null, $lang);
$itemSets = $item->itemSets();

$ariane = '<nav class="breadcrumbs content-with-margin">
    <ul>
        <li><a href="' . $url('site', ['site-slug' => $siteSlug]) . '">' . $escape($translate('Accueil')) . '</a></li>
        <li><a href="' . $searchingUrl . '">' . $escape($translate('Recherche')) . '</a></li>
        <li><span>' . $escape($resourceTitle) . '</span></li>
    </ul>
</nav>';

$themeFunctions->appendVarsToRootView([
    'resource' => $resource,
    'ariane' => $ariane,
    'mainClass' => 'item-content',
]);

$user = $this->identity();

if ($user) {
    $msgMissing = $themeSetting('access_msg_missing_file_user') ?: $translate('Fichier manquant : contacter le service');
    $msgRestricted = $themeSetting('access_msg_request_copy_user') ?: $translate('Document non accessible');
} else {
    $msgMissing = $themeSetting('access_msg_missing_file') ?: $translate('Fichier manquant : contacter le service');
    $msgRestricted = $themeSetting('access_msg_request_copy') ?: $translate('Connectez-vous');
}
?>

<div class="content">

    <?php $this->trigger('view.show.before'); ?>

    <div class="item-content-header">
        <?= $this->pageTitle($resourceTitle, 1) ?>
        <?php $auteurs = $resource->value('tef:auteur', ['all' => true]) ?: $resource->value('dcterms:creator', ['all' => true]); ?>
        <ul class="authors-and-date"><?= sprintf('%s (%s)', $auteurs ? implode(' ; ', $auteurs) : '[Inconnu]', $themeFunctions->year($resource)) ?></ul>
        <div class="document-type-and-access">
            <div class="document-type"><?= $escape($translate($documentType)) ?></div>
            <?php if ($accessLevel !== 'free' && !$themeSetting('access_display_item_hide_heading')): ?>
            <div class="document-access access-<?= $accessLevel ?>"><?= $accessLabel ?></div>
            <?php endif; ?>
        </div>
    </div>

    <?php if ($medias && $themeSetting('item_display_viewer')): ?>
    <?php // TODO Utiliser fonctions pour gérer tous les cas de visionneuses. ?>
    <div class="block block-media">
        <?php
           $media = reset($medias);
           $mediaType = $media->mediaType();
           $mainMediaType = strtok((string) $mediaType, '/');
           if (in_array($mainMediaType, ['image', 'video', 'audio'])): ?>
           <?= $plugins->has('mirador') ? $plugins->get('mirador')($item) : $this->thumbnail($media, 'medium') ?>
       </div>
        <?php elseif ($mediaType === 'application/pdf'): ?>
           <?= $media->render() ?>
        <?php else: ?>
           <?= $this->thumbnail($media, 'medium') ?>
        <?php endif; ?>
    </div>
    <?php endif; ?>

    <div class="resource-metadata-and-document-parts">
        <ul class="resource-metadata">
            <?= $resource->displayValues(['resource' => $resource]) ?>
            <?php if (count($itemSets)): ?>
            <li>
                <label><?= $translate('Item sets') ?></label>
                <ul>
                    <?php foreach ($itemSets as $itemSet): ?>
                    <li><a href="<?= $escapeAttr($itemSet->url()); ?>"><?= $itemSet->displayTitle(null, $lang); ?></a></li>
                    <?php endforeach; ?>
                </ul>
            </li>
            <?php endif; ?>
            <?php if ($siteSetting('show_attached_pages', true) && ($sitePages = $item->sitePages($site->id()))): ?>
            <li>
                <label><?php echo $translate('Site pages'); ?></label>
                <ul>
                    <?php foreach ($sitePages as $sitePage): ?>
                    <li><?= $sitePage->link($sitePage->title()); ?></li>
                    <?php endforeach; ?>
                </ul>
            </li>
            <?php endif; ?>
            <?php /*
            $subjectValues = $item->displaySubjectValues([
                'page' => (int) $this->params()->fromQuery('page', 1),
                'perPage' => 25,
                'resourceProperty' => $this->params()->fromQuery('resource_property'),
            ]);
            ?>
            <?php if ($subjectValues): ?>
            <li>
                <label><?= $translate('Linked resources') ?></label>
                <?= $subjectValues ?>
            </li>
            <?php endif; ?>
            */ ?>
        </ul>
        <aside class="aside-document-parts">
            <div class="aside-content">
                <?php if (!count($medias)): ?>
                <ul class="media-list">
                    <li class="document-parts">
                        <p><?= $translate('Pas de fichier disponible') ?></p>
                    </li>
                </ul>
                <?php else: ?>
                <ul class="media-list">
                    <?php foreach ($medias as $media):
                        $title = $media->displayTitle();
                        $accessLevelMedia = $themeFunctions->accessLevel($media);
                        $accessLabelMedia = $themeFunctions->accessLabel($accessLevelMedia);
                        $originalUrl = $media->originalUrl();
                        if ($accessLevelMedia === 'reserved') {
                            $accessLabelMedia = $translate('Document en accès restreint');
                        }
                        if ($accessLevelMedia !== 'free') {
                            $embargo = null;
                            if ($accessStatus) {
                                $accessStatusMedia = $accessStatus($media);
                                if ($accessStatusMedia) {
                                    if ($accessStatusMedia->isUnderEmbargo()) {
                                        $embargo = $accessStatusMedia->embargoEnd();
                                    }
                                } else {
                                    $embargo = $media->value('curation:end');
                                }
                            } else {
                                $embargo = $media->value('curation:end');
                            }
                            if ($embargo) {
                                $date = $embargo instanceof DateTime ? $embargo : DateTime::createFromFormat('Y-m-d', $embargo->value());
                                if (!$date) {
                                    $this->logger()->err('Date incorrecte dans curation:end du media #' . $media->id());
                                }
                                $accessLabelMedia .= ' jusqu’au ' . ($date ? $date->format('d-m-Y') : $embargo->value());
                            }
                        }
                    ?>
                    <li class="document-parts">
                        <span class="document-part-name"><?= $title ?></span>
                        <div class="document-access access-<?= $accessLevelMedia ?>"><?= $accessLabelMedia ?></div>
                        <div class="document-edition">

                            <?php if ($accessLevelMedia === 'free'
                                || ($isAllowedMediaContent && $isAllowedMediaContent($media))
                            ): ?>

                            <ul class="form-buttons">
                                <?php if ($originalUrl): ?>
                                <li><a href="<?= $originalUrl ?>" class="form-button preview-button" target="_blank"><?= $translate('Visualiser') ?></a></li>
                                <li><a href="<?= $originalUrl ?>?download=1" class="form-button download-button" download="<?= $escapeAttr($media->source() ?: 'download') ?>" target="_self"><?= $translate('Télécharger') ?></a></li>
                                <?php else: ?>
                                <li><a href="" class="form-button ask-copy-button"><?= $escape($msgMissing) ?></a></li>
                                <?php endif; ?>
                            </ul>

                            <?php elseif ($accessLevelMedia === 'reserved'): ?>

                            <ul class="form-buttons">
                                <li><a href="" class="form-button ask-copy-button"><?= $escape($msgRestricted) ?></a></li>
                            </ul>

                            <?php elseif ($accessLevelMedia === 'forbidden'): ?>

                            <ul class="form-buttons">
                                <li><a href="" class="form-button ask-copy-button"><?= $escape($msgRestricted) ?></a></li>
                            </ul>

                            <?php endif; ?>

                        </div>
                    </li>
                    <?php endforeach; ?>
                </ul>
                <?php endif; ?>
            </div>
        </aside>
    </div>

    <div class="item-reference">
        <h3><?= $translate('Citation bibliographique') ?></h3>
        <p><?= $citation ?></p>
    </div>

    <?php $this->trigger('view.show.after'); ?>

</div>
